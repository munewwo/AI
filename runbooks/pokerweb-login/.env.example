# Copy this to .env only if you are comfortable keeping local secrets on disk.
# Prefer passing POKERWEB_PASSWORD at runtime from a password manager.
POKERWEB_URL=https://japanopt.pokerweb.com.br/usuarios/login/?

# Optional. Leave blank to make the script ask each time.
POKERWEB_USERNAME=
POKERWEB_PASSWORD=

# Optional. Leave blank to make the script ask for the current 2FA code.
POKERWEB_2FA_CODE=

# Optional. A persistent browser profile stores session cookies after 2FA.
# This is intentionally gitignored because it can authenticate as the user.
POKERWEB_PROFILE_DIR=.pokerweb-profile

# Optional. Use "false" for visible browser automation, "true" for CI.
POKERWEB_HEADLESS=false

